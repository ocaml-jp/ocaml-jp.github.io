(version 0.2.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (conf-oniguruma ocaml dune dune-configurator)))

(source
 (fetch
  (url
   https://github.com/alan-j-hu/ocaml-oniguruma/releases/download/0.2.0/oniguruma-0.2.0.tbz)
  (checksum
   sha512=aebff5da068803bb68d9b2d819b59a9242324b95ba64d5f92545e1d9a19670950461cdf434c3ea124e701a4df2cc0b1a3ec03c31720523f584753ceddea863c8)))
