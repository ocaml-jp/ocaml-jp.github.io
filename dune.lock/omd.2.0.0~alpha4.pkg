(version 2.0.0~alpha4)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml uutf uucp uunf dune-build-info)))

(source
 (fetch
  (url
   https://github.com/ocaml/opam-source-archives/raw/main/omd-2.0.0.alpha4.tbz)
  (checksum
   sha512=cf86b7bf94581489f7dae5922a4c669691128b500f52a5b9acc3af2c062db8c5e992c9116cf2ac067f2b9777cdd1e027d8ca1152cb8c1606208c6401ea1d8662)))
